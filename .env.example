DEMO_MODE=true
# Email validation API
# Used when DEMO_MODE=false, or when you want real deliverability checks.
EMAIL_VALIDATOR_API_KEY=your_email_validator_api_key

# OpenRouter AI email writing
# The API key stays on the backend. Never expose it as NEXT_PUBLIC_*.
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=~openai/gpt-latest
OPENROUTER_SITE_URL=http://127.0.0.1:3000
OPENROUTER_APP_NAME=Real Estate Lead Automation

# Twilio Lookup API
# Used for real phone validation.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# Twilio Programmable Voice
# PUBLIC_BASE_URL must be publicly reachable by Twilio, for example an ngrok URL in local testing.
TWILIO_PHONE_NUMBER=your_twilio_voice_number
PUBLIC_BASE_URL=http://127.0.0.1:8000
CALL_MIN_SCORE=50
CALL_COOLDOWN_HOURS=24

# SMTP email sending
# For Gmail, use an App Password, not your normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM_EMAIL=your_email@example.com
SMTP_FROM_NAME=Real Estate Sales Team
SMTP_USE_TLS=true

# WhatsApp / Meta Cloud API
WHATSAPP_PROVIDER=meta
WHATSAPP_VERIFY_TOKEN=12345678
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_WABA_ID=your_whatsapp_business_account_id
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com/v20.0
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# Local storage
DATA_DIR=data
DATABASE_PATH=data/lead_automation.sqlite3
